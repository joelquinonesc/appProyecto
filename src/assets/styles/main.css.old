/* =========================================================
   🧬 ANXRISK - Sistema de Diseño CSS
   Aplicación Médica para Evaluación de Riesgo de Ansiedad
   Versión: 2.1 - Fondo Gris Profesional
   ========================================================= */

/* ============================================
   1. VARIABLES CSS - Sistema de Diseño
   ============================================ */
:root {
    /* Colores Principales */
    --color-primary: #2B87D1;
    --color-primary-dark: #1F6DB5;
    --color-primary-light: #64B5F6;
    
    /* Colores de Fondo */
    --color-background: #E8E8E8;
    --color-surface: #FFFFFF;
    --color-surface-variant: #F5F8FB;
    
    /* Colores de Texto */
    --color-text-primary: #2E2E2E;
    --color-text-secondary: #666666;
    --color-text-disabled: #9E9E9E;
    
    /* Colores de Acento */
    --color-success: #4CAF50;
    --color-warning: #FF9800;
    --color-error: #F44336;
    --color-info: #2196F3;
    
    /* Bordes y Divisores */
    --color-border: #D1D1D1;
    --color-divider: #E0E0E0;
    
    /* Sombras */
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 3px 12px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 6px 20px rgba(0, 0, 0, 0.12);
    --shadow-xl: 0 10px 40px rgba(0, 0, 0, 0.15);
    
    /* Radios de Borde */
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-full: 9999px;
    
    /* Sistema de Espaciado */
    --space-xs: 0.5rem;    /* 8px */
    --space-sm: 1rem;      /* 16px */
    --space-md: 1.5rem;    /* 24px */
    --space-lg: 2rem;      /* 32px */
    --space-xl: 3rem;      /* 48px */
    --space-2xl: 4rem;     /* 64px */
    
    /* Tipografía */
    --font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    --font-size-xs: 0.75rem;   /* 12px */
    --font-size-sm: 0.875rem;  /* 14px */
    --font-size-base: 1rem;    /* 16px */
    --font-size-lg: 1.125rem;  /* 18px */
    --font-size-xl: 1.25rem;   /* 20px */
    --font-size-2xl: 1.5rem;   /* 24px */
    --font-size-3xl: 2rem;     /* 32px */
    --font-size-4xl: 2.5rem;   /* 40px */
    
    /* Transiciones */
    --transition-fast: 150ms ease-in-out;
    --transition-base: 250ms ease-in-out;
    --transition-slow: 350ms ease-in-out;
}

/* ============================================
   2. RESET Y ESTILOS BASE
   ============================================ */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    background-color: #E8E8E8 !important;
}

body {
    font-family: var(--font-family);
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-primary);
    background-color: #E8E8E8 !important;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* ASEGURAR TEXTO NEGRO EN AUTOCOMPLETADO DEL NAVEGADOR */
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
    -webkit-text-fill-color: #2E2E2E !important;
    -webkit-box-shadow: 0 0 0 1000px #FFFFFF inset !important;
    color: #2E2E2E !important;
}

/* Labels en negro */
label,
.stTextInput label,
.stNumberInput label,
.stSelectbox label {
    color: #2E2E2E !important;
    font-weight: 500 !important;
}

/* ============================================
   3. FONDO GRIS EN STREAMLIT
   ============================================ */
.stApp {
    background-color: #E8E8E8 !important;
}

.main {
    background-color: #E8E8E8 !important;
}

/* Eliminar todos los espacios superiores */
.block-container {
    padding-top: 0 !important;
    padding-bottom: var(--space-lg) !important;
    margin-top: 0 !important;
    max-width: 1400px !important;
    background-color: #E8E8E8 !important;
}

section.main {
    padding-top: 0 !important;
    margin-top: 0 !important;
    background-color: #E8E8E8 !important;
}

section.main > div,
section.main > div:first-child {
    padding-top: 0 !important;
    margin-top: 0 !important;
    background-color: #E8E8E8 !important;
}

div[data-testid="stVerticalBlock"],
div[data-testid="stVerticalBlock"] > div:first-child {
    padding-top: 0 !important;
    margin-top: 0 !important;
}

/* Ocultar header y toolbar de Streamlit */
header[data-testid="stHeader"],
div[data-testid="stToolbar"],
.stDeployButton {
    display: none !important;
    height: 0 !important;
}

/* ============================================
   4. ESTRUCTURA PRINCIPAL
   ============================================ */
.main-content {
    background-color: #E8E8E8;
    min-height: 100vh;
    padding: 0 var(--space-lg) var(--space-2xl);
    max-width: 1200px;
    margin: 0 auto;
}

/* ============================================
   5. LOGO Y BRANDING
   ============================================ */
.logo-section {
    text-align: center !important;
    padding: 0 !important;
    margin: 0 0 var(--space-sm) 0 !important;
    line-height: 0 !important;
    animation: fadeInDown 0.6s ease-out;
    background-color: transparent !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}

.logo-section img {
    max-width: 50% !important;
    height: auto !important;
    filter: drop-shadow(var(--shadow-sm));
    transition: transform var(--transition-base);
    margin: 0 auto !important;
    padding: 0 !important;
    display: block !important;
}

.logo-section img:hover {
    transform: scale(1.02);
}

/* ============================================
   6. TIPOGRAFÍA
   ============================================ */
.big-title {
    font-size: var(--font-size-4xl) !important;
    font-weight: 700 !important;
    color: var(--color-primary) !important;
    text-align: center;
    margin: var(--space-lg) 0 var(--space-md) 0 !important;
    letter-spacing: -0.02em;
    line-height: 1.2;
    animation: fadeIn 0.8s ease-out;
}

.subtitle {
    font-size: var(--font-size-xl) !important;
    color: var(--color-text-secondary) !important;
    text-align: center;
    margin: var(--space-sm) auto var(--space-md) auto !important;
    font-weight: 400 !important;
    max-width: 800px;
    line-height: 1.6;
    padding: 0 var(--space-md);
    animation: fadeIn 1s ease-out;
}

.welcome-title {
    font-size: var(--font-size-2xl) !important;
    font-weight: 600 !important;
    color: var(--color-text-primary) !important;
    text-align: center;
    margin: var(--space-lg) auto var(--space-md) auto !important;
    max-width: 900px;
    line-height: 1.4;
    padding: 0 var(--space-md);
    animation: fadeIn 0.9s ease-out;
}

h1, h2, h3, h4, h5, h6 {
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-primary);
}

p {
    margin-bottom: var(--space-md);
    line-height: 1.7;
}

/* ============================================
   7. SECCIÓN DE BIENVENIDA
   ============================================ */
.welcome-text {
    background: var(--color-surface);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin: 0 auto var(--space-xl) auto;
    max-width: 900px;
    border: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    animation: slideUp 0.8s ease-out;
}

.welcome-text::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.welcome-text p {
    color: var(--color-text-primary);
    line-height: 1.8;
    margin-bottom: var(--space-md);
    font-size: var(--font-size-lg);
    text-align: justify;
}

.welcome-text p:last-child {
    margin-bottom: 0;
}

.welcome-text p:first-of-type {
    font-weight: 500;
}

/* ============================================
   8. TARJETAS INFORMATIVAS
   ============================================ */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0;
    animation: fadeIn 1s ease-out;
}

.info-card {
    background: var(--color-surface);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
    height: 100%;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.info-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light));
    transform: scaleX(0);
    transition: transform var(--transition-base);
}

.info-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary-light);
}

.info-card:hover::before {
    transform: scaleX(1);
}

.info-card h4 {
    font-size: var(--font-size-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
}

.info-card p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-base);
    line-height: 1.6;
    margin: 0;
}

/* ============================================
   9. BOTONES
   ============================================ */
.center-button {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin: var(--space-xl) 0 !important;
    text-align: center !important;
}

.center-button .stButton {
    display: flex !important;
    justify-content: center !important;
    width: 100% !important;
}

div[data-testid="column"] .stButton {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
}

.stButton > button {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%) !important;
    color: white !important;
    padding: 1rem 2.5rem !important;
    border-radius: var(--radius-full) !important;
    border: none !important;
    font-weight: 600 !important;
    font-size: var(--font-size-lg) !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition-base);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    width: 100% !important;
}

.stButton > button::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.stButton > button:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
}

.stButton > button:hover::before {
    width: 300px;
    height: 300px;
}

.stButton > button:active {
    transform: translateY(-1px);
}

.stButton > button:focus {
    outline: 3px solid rgba(43, 135, 209, 0.3);
    outline-offset: 2px;
}

/* ============================================
   10. NOTA DE CONFIDENCIALIDAD
   ============================================ */
.confidentiality-note {
    background: linear-gradient(135deg, var(--color-surface-variant) 0%, #E9ECEF 100%);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    text-align: center;
    border: 1px solid var(--color-border);
    margin-top: var(--space-xl);
    box-shadow: var(--shadow-sm);
    animation: fadeIn 1.2s ease-out;
    color: var(--color-text-primary);
}

.confidentiality-note::before {
    content: '🔒';
    display: block;
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-sm);
}

.confidentiality-note p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin: var(--space-xs) 0;
    line-height: 1.6;
}

/* ============================================
   11. FORMULARIOS Y CONTROLES
   ============================================ */

/* Títulos de páginas */
h1[class*="st-"] {
    color: #2E2E2E !important;
    font-size: var(--font-size-3xl) !important;
    font-weight: 700 !important;
    text-align: center;
    margin-bottom: var(--space-lg) !important;
}

/* Subtítulos de secciones */
h3[class*="st-"] {
    color: #2E2E2E !important;
    font-size: var(--font-size-xl) !important;
    font-weight: 600 !important;
    margin-top: var(--space-lg) !important;
    margin-bottom: var(--space-md) !important;
}

/* Contenedor de formulario */
div[data-testid="stForm"] {
    background: var(--color-surface) !important;
    padding: var(--space-xl) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-md) !important;
    border: 1px solid var(--color-border) !important;
    margin: var(--space-md) 0 !important;
}

/* Inputs de texto y selectores */
.stTextInput > div > div > input,
.stNumberInput > div > div > input,
.stNumberInput input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    border-radius: var(--radius-sm) !important;
    border: 1px solid var(--color-border) !important;
    transition: all var(--transition-fast) !important;
    padding: 0.75rem 1rem !important;
    font-size: var(--font-size-base) !important;
    color: #2E2E2E !important;
}

.stTextInput > div > div > input:hover,
.stNumberInput > div > div > input:hover,
.stNumberInput input:hover {
    border-color: var(--color-primary) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

.stTextInput > div > div > input:focus,
.stNumberInput > div > div > input:focus,
.stNumberInput input:focus {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(43, 135, 209, 0.1) !important;
    outline: none !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* FORZAR FONDO BLANCO Y TEXTO NEGRO EN TODOS LOS INPUTS */
input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Inputs dentro de contenedores de Streamlit */
.stTextInput input,
.stNumberInput input,
div[data-testid="stTextInput"] input,
div[data-testid="stNumberInput"] input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Todos los divs que contienen inputs */
.stTextInput > div,
.stNumberInput > div,
.stTextInput > div > div,
.stNumberInput > div > div,
.stTextInput > div > div > div,
.stNumberInput > div > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Placeholder text */
.stTextInput input::placeholder,
.stNumberInput input::placeholder {
    color: #999999 !important;
    opacity: 0.7 !important;
}

/* Input en focus */
.stTextInput input:focus,
.stNumberInput input:focus {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Selectbox con fondo blanco y texto negro */
.stSelectbox select,
.stSelectbox div[role="button"] {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Contenedores de number input con fondo blanco */
.stNumberInput > div,
.stNumberInput > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Botones de incremento/decremento del number input */
.stNumberInput button {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
    border: none !important;
}

.stNumberInput button:hover {
    background: #F5F5F5 !important;
    background-color: #F5F5F5 !important;
}

/* Forzar todos los elementos dentro de stNumberInput */
.stNumberInput * {
    background-color: transparent !important;
}

.stNumberInput > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Selectbox */
.stSelectbox > div > div,
.stSelectbox > div > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    border-radius: var(--radius-sm) !important;
    border: 1px solid var(--color-border) !important;
    transition: all var(--transition-fast) !important;
    color: #2E2E2E !important;
}

.stSelectbox > div > div:hover {
    border-color: var(--color-primary) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

.stSelectbox > div > div:focus-within {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(43, 135, 209, 0.1) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Texto dentro del selectbox */
.stSelectbox div[data-baseweb="select"] > div,
.stSelectbox div[data-baseweb="select"] span {
    color: #2E2E2E !important;
    background: #FFFFFF !important;
}

/* Opciones del dropdown del selectbox */
div[role="listbox"] {
    background: #FFFFFF !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-sm) !important;
    box-shadow: var(--shadow-md) !important;
}

div[role="option"] {
    color: #2E2E2E !important;
    background: #FFFFFF !important;
    padding: 0.75rem 1rem !important;
    transition: background-color var(--transition-fast) !important;
}

div[role="option"]:hover {
    background: #F5F8FB !important;
    background-color: #F5F8FB !important;
}

div[role="option"][aria-selected="true"] {
    background: #E3F2FD !important;
    background-color: #E3F2FD !important;
    font-weight: 600 !important;
}

/* Radio buttons y checkboxes */
.stRadio > label {
    color: var(--color-text-primary) !important;
    font-weight: 500 !important;
    font-size: var(--font-size-base) !important;
    margin-bottom: var(--space-sm) !important;
}

.stRadio > div {
    background: #FFFFFF !important;
    padding: 0.5rem !important;
    border-radius: var(--radius-sm) !important;
}

.stRadio > div[role="radiogroup"] {
    gap: 1rem !important;
    display: flex !important;
    flex-direction: row !important;
}

.stRadio > div[role="radiogroup"] > label {
    background: #FFFFFF !important;
    padding: 0.75rem 1.5rem !important;
    border: 2px solid #D1D1D1 !important;
    border-radius: var(--radius-sm) !important;
    cursor: pointer !important;
    transition: all var(--transition-fast) !important;
    color: #2E2E2E !important;
    font-weight: 500 !important;
    min-width: 80px !important;
    text-align: center !important;
}

.stRadio > div[role="radiogroup"] > label:hover {
    border-color: #4CAF50 !important;
    background: #F5F5F5 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
}

.stRadio > div[role="radiogroup"] > label[data-checked="true"] {
    background: #4CAF50 !important;
    border-color: #4CAF50 !important;
    color: #FFFFFF !important;
    font-weight: 600 !important;
    box-shadow: 0 2px 8px rgba(76, 175, 80, 0.3) !important;
}

/* Ocultar el círculo de radio nativo */
.stRadio input[type="radio"] {
    display: none !important;
}

/* Contenedor de preguntas */
.question-container {
    background: #FFFFFF !important;
    padding: 1rem 1.5rem !important;
    margin: 0.75rem 0 !important;
    border-radius: 8px !important;
    border: 1px solid #E0E0E0 !important;
    transition: all var(--transition-fast) !important;
}

.question-container:hover {
    border-color: #4CAF50 !important;
    box-shadow: 0 2px 8px rgba(76, 175, 80, 0.1) !important;
}

/* ============================================
   10. NOTA DE CONFIDENCIALIDAD
   ============================================ */
.confidentiality-note {
    background: linear-gradient(135deg, var(--color-surface-variant) 0%, #E9ECEF 100%);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    text-align: center;
    border: 1px solid var(--color-border);
    margin-top: var(--space-xl);
    box-shadow: var(--shadow-sm);
    animation: fadeIn 1.2s ease-out;
    color: var(--color-text-primary);
}

.confidentiality-note::before {
    content: '🔒';
    display: block;
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-sm);
}

.confidentiality-note p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    margin: var(--space-xs) 0;
    line-height: 1.6;
}

/* ============================================
   11. FORMULARIOS Y CONTROLES
   ============================================ */

/* Títulos de páginas */
h1[class*="st-"] {
    color: #2E2E2E !important;
    font-size: var(--font-size-3xl) !important;
    font-weight: 700 !important;
    text-align: center;
    margin-bottom: var(--space-lg) !important;
}

/* Subtítulos de secciones */
h3[class*="st-"] {
    color: #2E2E2E !important;
    font-size: var(--font-size-xl) !important;
    font-weight: 600 !important;
    margin-top: var(--space-lg) !important;
    margin-bottom: var(--space-md) !important;
}

/* Contenedor de formulario */
div[data-testid="stForm"] {
    background: var(--color-surface) !important;
    padding: var(--space-xl) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-md) !important;
    border: 1px solid var(--color-border) !important;
    margin: var(--space-md) 0 !important;
}

/* Inputs de texto y selectores */
.stTextInput > div > div > input,
.stNumberInput > div > div > input,
.stNumberInput input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    border-radius: var(--radius-sm) !important;
    border: 1px solid var(--color-border) !important;
    transition: all var(--transition-fast) !important;
    padding: 0.75rem 1rem !important;
    font-size: var(--font-size-base) !important;
    color: #2E2E2E !important;
}

.stTextInput > div > div > input:hover,
.stNumberInput > div > div > input:hover,
.stNumberInput input:hover {
    border-color: var(--color-primary) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

.stTextInput > div > div > input:focus,
.stNumberInput > div > div > input:focus,
.stNumberInput input:focus {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(43, 135, 209, 0.1) !important;
    outline: none !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* FORZAR FONDO BLANCO Y TEXTO NEGRO EN TODOS LOS INPUTS */
input[type="text"],
input[type="number"],
input[type="email"],
input[type="password"],
input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Inputs dentro de contenedores de Streamlit */
.stTextInput input,
.stNumberInput input,
div[data-testid="stTextInput"] input,
div[data-testid="stNumberInput"] input {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Todos los divs que contienen inputs */
.stTextInput > div,
.stNumberInput > div,
.stTextInput > div > div,
.stNumberInput > div > div,
.stTextInput > div > div > div,
.stNumberInput > div > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Placeholder text */
.stTextInput input::placeholder,
.stNumberInput input::placeholder {
    color: #999999 !important;
    opacity: 0.7 !important;
}

/* Input en focus */
.stTextInput input:focus,
.stNumberInput input:focus {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Selectbox con fondo blanco y texto negro */
.stSelectbox select,
.stSelectbox div[role="button"] {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
}

/* Contenedores de number input con fondo blanco */
.stNumberInput > div,
.stNumberInput > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Botones de incremento/decremento del number input */
.stNumberInput button {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    color: #2E2E2E !important;
    border: none !important;
}

.stNumberInput button:hover {
    background: #F5F5F5 !important;
    background-color: #F5F5F5 !important;
}

/* Forzar todos los elementos dentro de stNumberInput */
.stNumberInput * {
    background-color: transparent !important;
}

.stNumberInput > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Selectbox */
.stSelectbox > div > div,
.stSelectbox > div > div > div {
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
    border-radius: var(--radius-sm) !important;
    border: 1px solid var(--color-border) !important;
    transition: all var(--transition-fast) !important;
    color: #2E2E2E !important;
}

.stSelectbox > div > div:hover {
    border-color: var(--color-primary) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

.stSelectbox > div > div:focus-within {
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 0 3px rgba(43, 135, 209, 0.1) !important;
    background: #FFFFFF !important;
    background-color: #FFFFFF !important;
}

/* Texto dentro del selectbox */
.stSelectbox div[data-baseweb="select"] > div,
.stSelectbox div[data-baseweb="select"] span {
    color: #2E2E2E !important;
    background: #FFFFFF !important;
}

/* Opciones del dropdown del selectbox */
div[role="listbox"] {
    background: #FFFFFF !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-sm) !important;
    box-shadow: var(--shadow-md) !important;
}

div[role="option"] {
    color: #2E2E2E !important;
    background: #FFFFFF !important;
    padding: 0.75rem 1rem !important;
    transition: background-color var(--transition-fast) !important;
}

div[role="option"]:hover {
    background: #F5F8FB !important;
    background-color: #F5F8FB !important;
}

div[role="option"][aria-selected="true"] {
    background: #E3F2FD !important;
    background-color: #E3F2FD !important;
    font-weight: 600 !important;
}

/* Radio buttons y checkboxes */
.stRadio > label {
    color: var(--color-text-primary) !important;
    font-weight: 500 !important;
    font-size: var(--font-size-base) !important;
    margin-bottom: var(--space-sm) !important;
}

.stRadio > div {
    background: #FFFFFF !important;
    padding: 0.5rem !important;
    border-radius: var(--radius-sm) !important;
}

.stRadio > div[role="radiogroup"] {
    gap: 1rem !important;
    display: flex !important;
    flex-direction: row !important;
}

.stRadio > div[role="radiogroup"] > label {
    background: #FFFFFF !important;
    padding: 0.75rem 1.5rem !important;
    border: 2px solid #D1D1D1 !important;
    border-radius: var(--radius-sm) !important;
    cursor: pointer !important;
    transition: all var(--transition-fast) !important;
    color: #2E2E2E !important;
    font-weight: 500 !important;
    min-width: 80px !important;
    text-align: center !important;
}

.stRadio > div[role="radiogroup"] > label:hover {
    border-color: #4CAF50 !important;
    background: #F5F5F5 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
}

.stRadio > div[role="radiogroup"] > label[data-checked="true"] {
    background: #4CAF50 !important;
    border-color: #4CAF50 !important;
    color: #FFFFFF !important;
    font-weight: 600 !important;
    box-shadow: 0 2px 8px rgba(76, 175, 80, 0.3) !important;
}

/* Ocultar el círculo de radio nativo */
.stRadio input[type="radio"] {
    display: none !important;
}

/* Contenedor de preguntas */
.question-container {
    background: #FFFFFF !important;
    padding: 1rem 1.5rem !important;
    margin: 0.75rem 0 !important;
    border-radius: 8px !important;
    border: 1px solid #E0E0E0 !important;
    transition: all var(--transition-fast) !important;
}

.question-container:hover {
    border-color: #4CAF50 !important;
    box-shadow: 0 2px 8px rgba(76, 175, 80, 0.1) !important;
}

/* ============================================
   13. ANIMACIONES
   ============================================ */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

.animate-fade-in {
    animation: fadeIn 0.6s ease-out;
}

/* ============================================
   14. UTILIDADES
   ============================================ */
.text-center {
    text-align: center !important;
}

.text-primary {
    color: var(--color-primary) !important;
}

.bg-surface {
    background-color: var(--color-surface) !important;
}

.shadow-md {
    box-shadow: var(--shadow-md);
}

/* ============================================
   15. DISEÑO RESPONSIVO
   ============================================ */
@media (max-width: 1024px) {
    .main-content {
        padding: 0 var(--space-md) var(--space-xl);
    }
    
    .features-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    }
}

@media (max-width: 768px) {
    :root {
        --font-size-4xl: 2rem;
        --font-size-3xl: 1.75rem;
        --font-size-2xl: 1.5rem;
    }
    
    .main-content {
        padding: 0 var(--space-sm) var(--space-lg);
    }
    
    .logo-section img {
        max-width: 70% !important;
    }
    
    .subtitle {
        font-size: var(--font-size-lg) !important;
        padding: 0 var(--space-sm);
    }
    
    .welcome-text {
        padding: var(--space-lg);
        margin: 0 auto var(--space-lg) auto;
    }
    
    .welcome-text p {
        font-size: var(--font-size-base);
    }
    
    .features-grid {
        grid-template-columns: 1fr;
        gap: var(--space-md);
    }
    
    .info-card {
        padding: var(--space-lg);
    }
    
    .stButton > button {
        padding: 0.9rem 2.5rem !important;
        font-size: var(--font-size-base) !important;
    }
    
    .confidentiality-note {
        padding: var(--space-md);
    }
}

@media (max-width: 480px) {
    .main-content {
        padding: 0 var(--space-xs) var(--space-md);
    }
    
    .logo-section img {
        max-width: 85% !important;
    }
    
    .welcome-text {
        padding: var(--space-md);
        border-radius: var(--radius-sm);
    }
    
    .info-card {
        padding: var(--space-md);
    }
    
    .stButton > button {
        padding: 0.8rem 2rem !important;
        font-size: var(--font-size-sm) !important;
    }
}

/* ============================================
   16. MODO IMPRESIÓN
   ============================================ */
@media print {
    .stButton,
    [data-testid="stSidebar"],
    .confidentiality-note {
        display: none !important;
    }
    
    .main-content {
        max-width: 100%;
        padding: 0;
    }
    
    .welcome-text,
    .info-card {
        box-shadow: none;
        border: 1px solid #ccc;
    }
}

/* ============================================
   17. ACCESIBILIDAD
   ============================================ */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* Mejorar contraste para lectores de pantalla */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
}

/* Focus visible mejorado */
*:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
}

/* Iconos y flechas del selectbox en negro */
.stSelectbox svg {
    color: #2E2E2E !important;
    fill: #2E2E2E !important;
}

.stSelectbox div[data-baseweb="select"] svg {
    color: #2E2E2E !important;
    fill: #2E2E2E !important;
}

/* Icono de dropdown cuando está abierto/cerrado */
.stSelectbox button svg,
.stSelectbox span svg {
    color: #2E2E2E !important;
    fill: #2E2E2E !important;
}

/* Asegurar que todos los elementos SVG dentro del select sean negros */
.stSelectbox path {
    fill: #2E2E2E !important;
}

/* ============================================
   ANXRISK COMPONENT CLASSES
   (Landing page, cards, hero, stats, etc.)
   ============================================ */

/* Additional CSS variables used by ANXRISK components */
:root {
    --primary:        #D4911D;
    --primary-light:  #E8A832;
    --primary-soft:   #FDE8C4;
    --primary-hover:  #B87A14;
    --surface:        #F0EDEA;
    --surface-card:   #FFFFFF;
    --text-primary:   #2D2D2D;
    --text-secondary: #6B6B6B;
    --border:         #D4D0CC;
    --border-focus:   #D4911D;
    --success:        #059669;
    --success-bg:     rgba(5, 150, 105, 0.10);
    --warning:        #D97706;
    --warning-bg:     rgba(217, 119, 6, 0.10);
    --danger:         #DC2626;
    --danger-bg:      rgba(220, 38, 38, 0.10);
    --info:           #4A90C4;
    --info-bg:        rgba(74, 144, 196, 0.10);
    --accent:         #D4911D;
    --accent-genetic: #7C3AED;
    --accent-genetic-bg: rgba(124, 58, 237, 0.08);
    --shadow-hover:   0 4px 12px rgba(0,0,0,0.08);
    --font-sans:      'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono:      'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    --ease:           0.2s ease;
    --ease-slow:      0.35s ease;
    --space-1:  0.25rem;
    --space-2:  0.5rem;
    --space-3:  0.75rem;
    --space-4:  1rem;
    --space-5:  1.25rem;
    --space-6:  1.5rem;
    --space-8:  2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
}

/* ANXRISK Card */
.anxrisk-card {
    background: var(--surface-card);
    border-radius: var(--radius-md, 12px);
    border: 1px solid var(--border);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--ease);
    margin-bottom: var(--space-6);
    width: 100%;
    text-align: center;
}

.anxrisk-card h3 {
    text-align: center !important;
    margin-bottom: var(--space-4) !important;
}

.anxrisk-card p {
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
}

.anxrisk-card:hover {
    box-shadow: var(--shadow-hover);
}

/* ANXRISK Hero Section */
.anxrisk-hero {
    text-align: center;
    padding: var(--space-10) var(--space-8) var(--space-8);
    margin-bottom: var(--space-8);
}

/* ANXRISK Logo */
.anxrisk-logo {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--space-6);
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #1A1A2E 0%, #2D2D44 40%, #1A1A2E 100%);
    border-radius: 28px;
    box-shadow:
        0 12px 40px rgba(0, 0, 0, 0.25),
        0 0 0 1px rgba(212, 145, 29, 0.15),
        inset 0 1px 0 rgba(255,255,255,0.05);
    position: relative;
    overflow: hidden;
}

.anxrisk-logo::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at 30% 20%, rgba(212, 145, 29, 0.08) 0%, transparent 60%);
    pointer-events: none;
}

.anxrisk-logo svg {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
}

.anxrisk-hero-title {
    font-size: 3.25rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.12em;
    color: var(--primary) !important;
    margin-bottom: var(--space-2) !important;
    text-transform: uppercase;
}

.anxrisk-hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    font-weight: 400;
    margin-bottom: var(--space-4);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
}

.anxrisk-hero-description {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 560px;
    margin: 0 auto var(--space-8);
    line-height: 1.7;
}

/* ANXRISK Feature Cards (Home) */
.anxrisk-feature-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-6);
    text-align: center;
    transition: all var(--ease);
    height: 100%;
}

.anxrisk-feature-card:hover {
    box-shadow: var(--shadow-hover);
    border-color: var(--primary-soft);
    transform: translateY(-2px);
}

.anxrisk-feature-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-4);
    background: rgba(212, 145, 29, 0.08);
    border-radius: var(--radius-md, 12px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.anxrisk-feature-card h4 {
    color: var(--text-primary);
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: var(--space-2);
}

.anxrisk-feature-card p {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
}

/* ANXRISK Stats Bar (Home) */
.anxrisk-stats-bar {
    display: flex;
    justify-content: center;
    gap: var(--space-12);
    padding: var(--space-6) var(--space-8);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 12px);
    margin: var(--space-8) 0;
}

.anxrisk-stat {
    text-align: center;
}

.anxrisk-stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--primary);
}

.anxrisk-stat-label {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
}

/* ANXRISK Badges */
.anxrisk-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    font-size: 0.9375rem;
    font-weight: 600;
}

.anxrisk-badge-low {
    background: var(--success-bg);
    color: var(--success);
}

.anxrisk-badge-moderate {
    background: var(--warning-bg);
    color: var(--warning);
}

.anxrisk-badge-high {
    background: var(--danger-bg);
    color: var(--danger);
}

/* ANXRISK Genetic Section */
.anxrisk-genetic-section {
    background: var(--surface-card);
    border: 1px solid rgba(124, 58, 237, 0.2);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-6);
    margin: var(--space-6) 0;
}

.anxrisk-genetic-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid rgba(124, 58, 237, 0.15);
}

.anxrisk-genetic-header h3 {
    color: var(--accent-genetic) !important;
    margin: 0 !important;
}

.anxrisk-genetic-tag {
    background: var(--accent-genetic-bg);
    border: 1px solid rgba(124, 58, 237, 0.2);
    color: var(--accent-genetic);
    border-radius: var(--radius-sm, 8px);
    padding: var(--space-2) var(--space-3);
    font-size: 1rem;
    font-weight: 600;
    display: inline-block;
}

/* ANXRISK Result Header */
.anxrisk-result-header {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-8);
    text-align: center;
    margin-bottom: var(--space-6);
    box-shadow: var(--shadow-sm);
}

.anxrisk-result-level {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: var(--space-2);
}

.anxrisk-result-level.low    { color: var(--success); }
.anxrisk-result-level.moderate { color: var(--warning); }
.anxrisk-result-level.high   { color: var(--danger); }

.anxrisk-result-prob {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-3);
}

.anxrisk-result-prob strong {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
}

.anxrisk-result-model {
    font-size: 1rem;
    color: var(--text-secondary);
}

/* ANXRISK Metric Card */
.anxrisk-metric {
    text-align: center;
    padding: var(--space-5);
    border-radius: var(--radius-md, 12px);
    background: var(--surface);
    border: 1px solid var(--border);
}

.anxrisk-metric-value {
    font-size: 1.75rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
    line-height: 1.2;
}

.anxrisk-metric-label {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
}

/* ANXRISK Note */
.anxrisk-note {
    background: var(--surface-card);
    border-left: 3px solid var(--primary-light);
    padding: var(--space-4) var(--space-5);
    border-radius: 0 var(--radius-sm, 8px) var(--radius-sm, 8px) 0;
    font-size: 1rem;
    color: var(--text-secondary);
    margin: var(--space-4) 0;
    box-shadow: var(--shadow-xs, 0 1px 2px rgba(0,0,0,0.04));
}

.anxrisk-note p {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
}

/* ANXRISK SHAP Colors */
.anxrisk-shap-increase {
    color: var(--danger);
    font-weight: 600;
}

.anxrisk-shap-decrease {
    color: var(--success);
    font-weight: 600;
}

/* ANXRISK Section Header */
.anxrisk-section-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--primary-soft);
    margin-bottom: var(--space-5);
}

.anxrisk-section-header h2,
.anxrisk-section-header h3 {
    margin: 0 !important;
    padding: 0 !important;
    color: var(--text-primary) !important;
}

/* ANXRISK Page Header */
.anxrisk-page-header {
    margin-bottom: var(--space-8);
    text-align: center;
}

.anxrisk-page-header h1 {
    color: var(--text-primary) !important;
    text-align: center !important;
    margin-bottom: var(--space-2) !important;
}

.anxrisk-page-header p {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.125rem;
    max-width: 600px;
    margin: 0 auto;
}

/* ANXRISK Risk Gauge */
.anxrisk-risk-gauge {
    height: 8px;
    border-radius: 4px;
    background: linear-gradient(to right,
        var(--success) 0%, var(--success) 30%,
        var(--warning) 30%, var(--warning) 60%,
        var(--danger) 60%, var(--danger) 100%);
    position: relative;
    margin: var(--space-4) 0;
}

.anxrisk-risk-gauge-marker {
    position: absolute;
    top: -4px;
    width: 4px;
    height: 16px;
    background: var(--text-primary);
    border-radius: 2px;
    transform: translateX(-50%);
}

/* ANXRISK Clinical Warning */
.anxrisk-clinical-warning {
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: var(--radius-sm, 8px);
    padding: var(--space-5) var(--space-6);
    font-size: 1rem;
    color: var(--text-primary);
    margin: var(--space-6) 0;
}

.anxrisk-clinical-warning strong {
    color: var(--warning);
}

/* ANXRISK Sidebar */
.anxrisk-sidebar-brand {
    text-align: center;
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
}

.anxrisk-sidebar-brand h1 {
    font-size: 1.375rem !important;
    font-weight: 700 !important;
    color: var(--primary) !important;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-1) !important;
}

.anxrisk-sidebar-brand p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
}

/* ANXRISK Questionnaire Card */
.anxrisk-question-card {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-4);
    transition: border-color var(--ease);
    width: 100%;
    text-align: center;
}

.anxrisk-question-card:hover {
    border-color: var(--primary-soft);
}

.anxrisk-question-number {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-2);
    text-align: center;
}

.anxrisk-question-text {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    line-height: 1.5;
    margin-bottom: var(--space-3);
    text-align: center;
}

/* ANXRISK Disclaimer */
.anxrisk-disclaimer {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-align: center;
    padding: var(--space-4);
    line-height: 1.5;
}

/* Animation: slide-up */
.animate-slide-up {
    animation: slideUp 0.4s ease-out;
}

/* ANXRISK Responsive Overrides */
@media (max-width: 768px) {
    .anxrisk-hero {
        padding: var(--space-8) var(--space-4);
    }

    .anxrisk-hero-title {
        font-size: 1.75rem !important;
    }

    .anxrisk-logo {
        width: 96px;
        height: 96px;
        border-radius: 22px;
    }

    .anxrisk-stats-bar {
        flex-direction: column;
        gap: var(--space-4);
    }

    .anxrisk-result-header {
        padding: var(--space-6);
    }
}
